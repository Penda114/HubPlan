# ---------------------------------------------------------
# HubPlan — variables d'environnement
# Copie ce fichier en `.env` et remplis les valeurs.
# ---------------------------------------------------------

# Secret de signature des sessions (génère-le avec `npx auth secret`)
AUTH_SECRET=

# Base de données Postgres (Neon) — chaîne de connexion "pooled"
DATABASE_URL=

# Identifiants de la GitHub OAuth App
# https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# (optionnel) Repo GitHub d'origine, conservé pour de futurs imports
GITHUB_OWNER=
GITHUB_REPO=
