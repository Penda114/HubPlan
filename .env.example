# ---------------------------------------------------------
# HubPlan — variables d'environnement
# Copie ce fichier en `.env` et remplis les valeurs.
# ---------------------------------------------------------

# Secret de signature des sessions (génère-le avec `npx auth secret`)
AUTH_SECRET=

# Base de données Postgres (Neon) — chaîne de connexion "pooled"
DATABASE_URL=

# Identifiants de la GitHub OAuth App
# https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Dépôt GitHub du jeu : sert au titre dynamique ET de destination des sauvegardes
GITHUB_OWNER=
GITHUB_REPO=

# (optionnel) Jeton GitHub avec le droit Contents: write sur le dépôt
# Nécessaire pour la sauvegarde automatique (et pour lire un dépôt privé)
GITHUB_TOKEN=

# (optionnel) Secret protégeant l'appel de sauvegarde par le cron Vercel
# Vercel l'envoie automatiquement en en-tête Authorization des crons
CRON_SECRET=
